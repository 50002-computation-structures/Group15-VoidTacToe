module tester_auto_alu (
    input clk,
    input rst,
    input slow_clock[8],
    input start,
    input alu_out[32],
    input forced_error,
    output a[32],
    output b[32],
    output out[32],
    output alufn[6],
    output state_bits[5],
    output index_out[6],
    output run_bit,
    output error_bit  
) {
        const A_INPUTS = $reverse({
        // ===== ADD/SUB (00-07) =====
        32d0,         // 00 ADD 0 + 0
        32h7FFFFFFF,  // 01 ADD pos overflow
        32hFFFFFFFD,  // 02 ADD two negatives (-3)
        32d10,        // 03 ADD decrement by -1
        32d7,         // 04 SUB 7 - 5
        32h80000000,  // 05 SUB neg overflow
        32d42,        // 06 SUB equal values Z flag
        32d5,         // 07 SUB pos - neg
    
        // ===== Boolean (08-18) =====
        32hFF00FF00,  // 08 AND basic mask
        32hAAAAAAAA,  // 09 AND no common bits
        32h12345678,  // 10 AND identity
        32hFF00FF00,  // 11 OR combine disjoint
        32h12345678,  // 12 OR one side zero
        32h12345678,  // 13 OR saturation
        32hDEADBEEF,  // 14 XOR identical cancel
        32hAAAAAAAA,  // 15 XOR alternating bits
        32hDEADBEEF,  // 16 XOR identity
        32h12345678,  // 17 A pass-through
        32h00000000,  // 18 A zero remains zero
    
        // ===== Compare (19-30) =====
        32d5,         // 19 CMPEQ true (5==5)
        32d0,         // 20 CMPEQ false (0!=1)
        32d0,         // 21 CMPEQ both zero
        32hFFFFFFFD,  // 22 CMPLT true (-3<0)
        32d0,         // 23 CMPLT true (0<1)
        32d5,         // 24 CMPLT false (5>3)
        32hFFFFFFFB,  // 25 CMPLT two negatives (-5<-1)
        32d7,         // 26 CMPLT equal false
        32d7,         // 27 CMPLE true (7<=7)
        32hFFFFFFFF,  // 28 CMPLE true (-1<=0)
        32d5,         // 29 CMPLE false (5>3)
        32hFFFFFFFD,  // 30 CMPLE two negatives (-3<=-1)
    
        // ===== Multiply (31-40) =====
        32d3,         // 31 MUL small positive
        32d12345,     // 32 MUL by zero
        32hFFFFFFF9,  // 33 MUL neg * pos (-7)
        32hFFFFFFF8,  // 34 MUL neg * neg (-8)
        32hFFFFFFFF,  // 35 MUL large truncation
        32h80000000,  // 36 MUL sign bit
        32d1024,      // 37 MUL power-of-two
        32h7FFFFFFF,  // 38 MUL overflow wrap
        32h12345678,  // 39 MUL identity
        32d7,         // 40 MUL by -1 negation
    
        // ===== Shift (41-51) =====
        32h00000001,  // 41 SHL 1<<1
        32h80000000,  // 42 SHL overflow
        32hDEADBEEF,  // 43 SHL by 0 no-op
        32h00000001,  // 44 SHL masked (33->1)
        32h00000008,  // 45 SHR 8>>2
        32h80000000,  // 46 SHR logical
        32h80000000,  // 47 SHR by 0 no-op
        32h80000000,  // 48 SHR masked (32->0)
        32h80000000,  // 49 SRA arithmetic
        32h80000000,  // 50 SRA fill all ones
        32h40000000,  // 51 SRA positive zero-fills
            
       // ===== Popcount =====
        32b000000000, // 52 POPCOUNT empty board → 0
        32b111111111, // 53 POPCOUNT full board → 9
        32b101010000, // 54 POPCOUNT 3 bits set → 3
        32hFFFFFFFF   // 55 POPCOUNT all 32 bits → 32
        })
    
    const B_INPUTS = $reverse({
        // ===== ADD/SUB =====
        32d0,         // 00
        32d1,         // 01
        32hFFFFFFFB,  // 02 (-5)
        32hFFFFFFFF,  // 03 (-1)
        32d5,         // 04
        32d1,         // 05
        32d42,        // 06
        32hFFFFFFFD,  // 07 (-3)
    
        // ===== Boolean =====
        32h0F0F0F0F,  // 08
        32h55555555,  // 09
        32hFFFFFFFF,  // 10
        32h00FF00FF,  // 11
        32h00000000,  // 12
        32hFFFFFFFF,  // 13
        32hDEADBEEF,  // 14
        32h55555555,  // 15
        32h00000000,  // 16
        32hFFFFFFFF,  // 17
        32hDEADBEEF,  // 18
    
        // ===== Compare =====
        32d5,         // 19
        32d1,         // 20
        32d0,         // 21
        32d0,         // 22
        32d1,         // 23
        32d3,         // 24
        32hFFFFFFFF,  // 25 (-1)
        32d7,         // 26
        32d7,         // 27
        32d0,         // 28
        32d3,         // 29
        32hFFFFFFFF,  // 30 (-1)
    
        // ===== Multiply =====
        32d4,         // 31
        32d0,         // 32
        32d6,         // 33
        32hFFFFFFFB,  // 34 (-5)
        32d2,         // 35
        32d2,         // 36
        32d1024,      // 37
        32d2,         // 38
        32d1,         // 39
        32hFFFFFFFF,  // 40 (-1)
    
        // ===== Shift =====
        32d1,         // 41
        32d1,         // 42
        32d0,         // 43
        32d33,        // 44
        32d2,         // 45
        32d1,         // 46
        32d0,         // 47
        32d32,        // 48
        32d1,         // 49
        32d31,        // 50
        32d2,         // 51
        
        // ===== Popcount =====
        32d0,         // 52
        32d0,         // 53
        32d0,         // 54
        32d0          // 55
    })
    
    const ALUFN_INPUTS = $reverse({
        // ===== ADD/SUB =====
        6h00,         // 00 ADD
        6h00,         // 01 ADD
        6h00,         // 02 ADD
        6h00,         // 03 ADD
        6h01,         // 04 SUB
        6h01,         // 05 SUB
        6h01,         // 06 SUB
        6h01,         // 07 SUB
    
        // ===== Boolean =====
        6b011000,     // 08 AND
        6b011000,     // 09 AND
        6b011000,     // 10 AND
        6b011110,     // 11 OR
        6b011110,     // 12 OR
        6b011110,     // 13 OR
        6b010110,     // 14 XOR
        6b010110,     // 15 XOR
        6b010110,     // 16 XOR
        6b011010,     // 17 A
        6b011010,     // 18 A
    
        // ===== Compare =====
        6b110011,     // 19 CMPEQ
        6b110011,     // 20 CMPEQ
        6b110011,     // 21 CMPEQ
        6b110101,     // 22 CMPLT
        6b110101,     // 23 CMPLT
        6b110101,     // 24 CMPLT
        6b110101,     // 25 CMPLT
        6b110101,     // 26 CMPLT
        6b110111,     // 27 CMPLE
        6b110111,     // 28 CMPLE
        6b110111,     // 29 CMPLE
        6b110111,     // 30 CMPLE
    
        // ===== Multiply =====
        6b000010,     // 31 MUL
        6b000010,     // 32 MUL
        6b000010,     // 33 MUL
        6b000010,     // 34 MUL
        6b000010,     // 35 MUL
        6b000010,     // 36 MUL
        6b000010,     // 37 MUL
        6b000010,     // 38 MUL
        6b000010,     // 39 MUL
        6b000010,     // 40 MUL
    
        // ===== Shift =====
        6b100000,     // 41 SHL
        6b100000,     // 42 SHL
        6b100000,     // 43 SHL
        6b100000,     // 44 SHL
        6b100001,     // 45 SHR
        6b100001,     // 46 SHR
        6b100001,     // 47 SHR
        6b100001,     // 48 SHR
        6b100011,     // 49 SRA
        6b100011,     // 50 SRA
        6b100011,      // 51 SRA
        
        // ===== Popcount =====
        6b000100,
        6b000100,
        6b000100,
        6b000100
      })
    
    const RESULTS = $reverse({
        // ===== ADD/SUB =====
        32d0,         // 00 ADD 0 + 0
        32h80000000,  // 01 ADD pos overflow
        32hFFFFFFF8,  // 02 ADD two negatives (-8)
        32d9,         // 03 ADD decrement by -1
        32d2,         // 04 SUB 7 - 5
        32h7FFFFFFF,  // 05 SUB neg overflow
        32d0,         // 06 SUB equal values Z flag
        32d8,         // 07 SUB pos - neg
    
        // ===== Boolean =====
        32h0F000F00,  // 08 AND basic mask
        32h00000000,  // 09 AND no common bits
        32h12345678,  // 10 AND identity
        32hFFFFFFFF,  // 11 OR combine disjoint
        32h12345678,  // 12 OR one side zero
        32hFFFFFFFF,  // 13 OR saturation
        32h00000000,  // 14 XOR identical cancel
        32hFFFFFFFF,  // 15 XOR alternating bits
        32hDEADBEEF,  // 16 XOR identity
        32h12345678,  // 17 A pass-through
        32h00000000,  // 18 A zero remains zero
    
        // ===== Compare =====
        32b1,         // 19 CMPEQ true
        32b0,         // 20 CMPEQ false
        32b1,         // 21 CMPEQ both zero
        32b1,         // 22 CMPLT true (-3<0)
        32b1,         // 23 CMPLT true (0<1)
        32b0,         // 24 CMPLT false (5>3)
        32b1,         // 25 CMPLT two negatives
        32b0,         // 26 CMPLT equal false
        32b1,         // 27 CMPLE true (7<=7)
        32b1,         // 28 CMPLE true (-1<=0)
        32b0,         // 29 CMPLE false (5>3)
        32b1,         // 30 CMPLE two negatives
    
        // ===== Multiply =====
        32d12,        // 31 MUL small positive
        32d0,         // 32 MUL by zero
        32hFFFFFFD6,  // 33 MUL neg * pos (-42)
        32d40,        // 34 MUL neg * neg
        32hFFFFFFFE,  // 35 MUL large truncation
        32h00000000,  // 36 MUL sign bit
        32h00100000,  // 37 MUL power-of-two
        32hFFFFFFFE,  // 38 MUL overflow wrap
        32h12345678,  // 39 MUL identity
        32hFFFFFFF9,  // 40 MUL by -1 negation (-7)
    
        // ===== Shift =====
        32d2,         // 41 SHL 1<<1
        32h00000000,  // 42 SHL overflow
        32hDEADBEEF,  // 43 SHL by 0 no-op
        32d2,         // 44 SHL masked (33->1)
        32d2,         // 45 SHR 8>>2
        32h40000000,  // 46 SHR logical
        32h80000000,  // 47 SHR by 0 no-op
        32h80000000,  // 48 SHR masked (32->0)
        32hC0000000,  // 49 SRA arithmetic
        32hFFFFFFFF,  // 50 SRA fill all ones
        32h10000000,  // 51 SRA positive zero-fills
            
        // ===== Popcount =====
        32d0, // 52 0 1's
        32d9, // 53 9 1's
        32d3, // 54 3 1's
        32d32 // 55 32 1's
    })

    enum States {START, LOOP, CHECK_RESULT, HALT}

    dff states[$width(States)](#INIT(States.START), .clk(clk), .rst(rst))
    dff index[6](.clk(clk), .rst(rst), #INIT(0))

    edge_detector rising_edge(.clk(clk), .in(slow_clock), #RISE(1), #FALL(0))
    edge_detector rising_edge_start(.clk(clk), .in(start), #RISE(1), #FALL(0))

    always {
        state_bits = 5b0
        run_bit = 0
        error_bit = 0

        states.d = states.q
        index.d = index.q

        a = A_INPUTS[index.q]
        b = B_INPUTS[index.q]
        alufn = ALUFN_INPUTS[index.q]
        out = RESULTS[index.q]
        
        index_out = index.q

        case(states.q) {
            States.START:
                state_bits = 5b00001
                run_bit = 1
                if (rising_edge.out) states.d = States.LOOP

            States.LOOP:
                run_bit = 1
                state_bits = 5b00010
                if (rising_edge.out) states.d = States.CHECK_RESULT

            States.CHECK_RESULT:
                state_bits = 5b00011
                run_bit = 1
                if (|(alu_out ^ RESULTS[index.q]) | forced_error) {
                    error_bit = 1
                }
                else {
                    if (rising_edge.out) {
                        if (~|(index.q ^ ($width(RESULTS, 0) - 1))) {
                            states.d = States.HALT
                        }
                        else {
                            index.d = index.q + 1
                            states.d = States.LOOP
                        }
                    }
                }

            States.HALT:
                state_bits = 5b11111
                if (rising_edge_start.out) {
                    index.d = 0
                    run_bit = 0
                    states.d = States.START
                }
        }
    }
}