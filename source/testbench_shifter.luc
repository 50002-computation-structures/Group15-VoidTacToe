testbench test_shifter {
    compact_shifter shifter
    
    // Format: c{a[32], b[5], alufn[6], expected[32]} = 75 bits total
    const TEST_CASES_SHIFT = $reverse({
        // 1. SHL: 1 << 1 = 2
        c{32h00000001, 5d1,  6b100000, 32h00000002},
        // 2. SHL: overflow (0x80000000 << 1 = 0)
        c{32h80000000, 5d1,  6b100000, 32h00000000},
        // 3. SHL: by 0 no-op
        c{32hDEADBEEF, 5d0,  6b100000, 32hDEADBEEF},
        // 4. SHR: 8 >> 2 = 2
        c{32h00000008, 5d2,  6b100001, 32h00000002},
        // 5. SHR: logical (0x80000000 >> 1 = 0x40000000)
        c{32h80000000, 5d1,  6b100001, 32h40000000},
        // 6. SHR: by 0 no-op
        c{32h80000000, 5d0,  6b100001, 32h80000000},
        // 7. SRA: arithmetic (0x80000000 >>> 1 = 0xC0000000)
        c{32h80000000, 5d1,  6b100011, 32hC0000000},
        // 8. SRA: fill all ones (0x80000000 >>> 31 = 0xFFFFFFFF)
        c{32h80000000, 5d31, 6b100011, 32hFFFFFFFF},
        // 9. SRA: positive zero-fills (0x40000000 >>> 2 = 0x10000000)
        c{32h40000000, 5d2,  6b100011, 32h10000000}
    })
    
    test shifterTest {
        repeat (i, 9){
            shifter.a     = TEST_CASES_SHIFT[i][74:43]
            shifter.b     = TEST_CASES_SHIFT[i][42:38]
            shifter.alufn = TEST_CASES_SHIFT[i][37:32]
            
            $tick()
            
            $assert(shifter.out == TEST_CASES_SHIFT[i][31:0])
            $print("PASS test case: %d", i+1)
        }
    }
}