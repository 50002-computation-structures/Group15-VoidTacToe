testbench testbench_add_sub {
    add_and_sub adder
    
    const TEST_VALUES_ALU = $reverse(
        {
            c{32h00000000, 32h00000000, 6h00, c{32h00000000, 1b1,1b0,1b0}}, // 00 ADD 0+0
            c{32h7FFFFFFF, 32h00000001, 6h00, c{32h80000000, 1b0,1b1,1b1}}, // 01 ADD pos overflow
            c{32hFFFFFFFD, 32hFFFFFFFB, 6h00, c{32hFFFFFFF8, 1b0,1b0,1b1}}, // 02 ADD two negatives
            c{32h0000000A, 32hFFFFFFFF, 6h00, c{32h00000009, 1b0,1b0,1b0}}, // 03 ADD decrement by -1
            c{32h00000007, 32h00000005, 6h01, c{32h00000002, 1b0,1b0,1b0}}, // 04 SUB 7-5
            c{32h80000000, 32h00000001, 6h01, c{32h7FFFFFFF, 1b0,1b1,1b0}}, // 05 SUB neg overflow
            c{32h0000002A, 32h0000002A, 6h01, c{32h00000000, 1b1,1b0,1b0}}, // 06 SUB equal Z flag
            c{32h00000005, 32hFFFFFFFD, 6h01, c{32h00000008, 1b0,1b0,1b0}}  // 07 SUB pos - neg
        }
    )
    
    test myTest {
        repeat(i, 8){
            adder.a      = TEST_VALUES_ALU[i][104:73]
            adder.b      = TEST_VALUES_ALU[i][72:41]
            adder.is_sub = TEST_VALUES_ALU[i][35]
            $tick()
            $assert(adder.out == TEST_VALUES_ALU[i][34:3])
            $assert(adder.z   == TEST_VALUES_ALU[i][2])
            $assert(adder.v   == TEST_VALUES_ALU[i][1])
            $assert(adder.n   == TEST_VALUES_ALU[i][0])
            $print("PASS test case: %d", i+1)
        }
    }
}