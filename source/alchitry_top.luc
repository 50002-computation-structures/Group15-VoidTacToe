module alchitry_top (
    input clk,              // 100MHz clock
    input rst_n,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs
    output io_led[3][8],     // LEDs on IO Shield
    output io_segment[8],        // 7-segment LEDs on IO Shield
    output io_select[4],        // Digit select on IO Shield
    input io_button[5],      // 5 buttons on IO Shield
    input io_dip[3][8]       // DIP switches on IO Shield
) {
    sig rst                 // reset signal
    
    const CLK_FREQ = $is_sim() ? 1000 : 100000000 // put 1000 for sim, 100000000 otherwise in hardware
    reset_conditioner reset_cond(.clk(clk), .in(~rst_n))

    button_conditioner place_cond(.clk(clk), .in(io_button[0]), #CLK_FREQ(CLK_FREQ))
    edge_detector place_edge(#RISE(1), #FALL(0), .clk(clk), .in(place_cond.out))

    button_conditioner start_cond(.clk(clk), .in(io_button[1]), #CLK_FREQ(CLK_FREQ))
    edge_detector start_edge(#RISE(1), #FALL(0), .clk(clk), .in(start_cond.out))
 
    sig cell_buttons[9]

    game_datapath game(
        .clk(clk),
        .rst(rst),
        .slowclk(1),
        .cell_buttons(cell_buttons),
        .start_btn(start_edge.out)
    )

    always {
        rst = reset_cond.out

        led = 8b0
        io_led = 3x{{8b0}}
        io_segment = 8b0
        io_select = 4b0

        cell_buttons = 9b0
        if (place_edge.out) {
            case (io_dip[0][3:0]) {
                4d0: cell_buttons = 9b000000001
                4d1: cell_buttons = 9b000000010
                4d2: cell_buttons = 9b000000100
                4d3: cell_buttons = 9b000001000
                4d4: cell_buttons = 9b000010000
                4d5: cell_buttons = 9b000100000
                4d6: cell_buttons = 9b001000000
                4d7: cell_buttons = 9b010000000
                4d8: cell_buttons = 9b100000000
                default: cell_buttons = 9b0
            }
        }

        io_led[0] = game.p1_leds[7:0]
        led[0] = game.p1_leds[8]
        io_led[1] = game.p2_leds[7:0]
        led[1] = game.p2_leds[8]
        io_led[2][0] = game.turn_led
        io_led[2][1] = game.game_over_led
        io_led[2][2] = game.winner_p1
        io_led[2][3] = game.winner_p2
        io_led[2][7:4] = io_dip[0][3:0]
    }
}
